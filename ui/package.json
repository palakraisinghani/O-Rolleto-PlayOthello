{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:web": "vite build --mode web && node scripts/finish-web.mjs",
    "test:web": "node scripts/e2e-web.mjs",
    "build:site": "node scripts/prepare-mobile.mjs && vite build --mode site && node scripts/finish-site.mjs",
    "build:mobile": "node scripts/prepare-mobile.mjs && vite build --mode mobile"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "onnxruntime-web": "^1.30.0"
  }
}
